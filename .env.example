# ============================================================
# Chatline – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ============================================================

# ── Database ──────────────────────────────────────────────
# PostgreSQL with the pgvector extension installed.
# Run once: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chatline?schema=public"

# ── better-auth ────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# The canonical URL of the app (used for OAuth callbacks)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth – create credentials at console.developers.google.com
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Groq ───────────────────────────────────────────────────
# Get your key at console.groq.com — free tier available
GROQ_API_KEY="gsk_..."

# ── Embeddings (local, free, no API key needed) ─────────────
# Uses @huggingface/transformers (ONNX) running in-process.
# Model is downloaded once (~23 MB) and cached to disk.
# Default: Xenova/all-MiniLM-L6-v2 (384-dim). Change to any sentence-transformers model.
# Leave unset to use the default.
# EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"

# ── Upstash Redis ──────────────────────────────────────────
# Rate limiting and the ingest queue. Create a free database at upstash.com.
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── S3-Compatible Object Storage ───────────────────────────
# Works with AWS S3, Cloudflare R2, Wasabi, MinIO, etc.
S3_ENDPOINT="https://your-bucket-endpoint"
S3_BUCKET="chatline"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# ── Razorpay Billing ───────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Plan IDs from your Razorpay dashboard (leave blank to disable paid plans)
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_GROWTH=""
RAZORPAY_PLAN_SCALE=""

# ── Public Variables (safe to expose to the browser) ───────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# ── Security ───────────────────────────────────────────────
# Optional: sign visitor IDs for the chat widget.
ENCRYPTION_KEY=""

# ── Worker ─────────────────────────────────────────────────
INGEST_CONCURRENCY="4"
